# 环境变量

# 与backend application.yml 严格一致
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com

# 主模型（DeepSeek V4.1-Flash，原生视觉输入；复杂步骤可回退 deepseek-chat/V4-Pro）
LLM_MODEL=deepseek-flash

# 视觉模型（看图选房）
VISION_API_KEY=sk-your-deepseek-key
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash

# 服务配置
SERVER_PORT=8080

# SQLite 向量库路径
VECTOR_DB_PATH=/opt/minsu/data/vectors.db

# 日志目录
LOG_PATH=/opt/minsu/logs
